#!/sbin/openrc-run
# Face authentication daemon for pam_linux_hello.so

description="linux_hello face authentication daemon"
command="/usr/local/bin/linux_hello"
# Extra daemon options from /etc/conf.d/linux_hello, e.g. LINUX_HELLO_ARGS="--enroll-on-failure"
command_args="daemon --socket /run/linux_hello.sock ${LINUX_HELLO_ARGS}"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/linux_hello.log"
error_log="/var/log/linux_hello.log"

export LINUX_HELLO_MODELS="/usr/local/share/linux_hello/models"

depend() {
    need localmount
    after udev
}
